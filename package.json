{
  "name": "onedb",
  "version": "0.1.4",
  "description": "OneDB - 多数据库管理工具（MySQL / PostgreSQL / MongoDB / MongoDB SRV / SQLite / Redis）",
  "main": "./out/main/index.js",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "gen:icon": "node scripts/gen-icon.mjs",
    "bump": "node scripts/version.mjs",
    "release": "node scripts/version.mjs patch --tag --push"
  },
  "dependencies": {
    "ioredis": "^5.4.1",
    "mongodb": "^6.12.0",
    "mysql2": "^3.12.0",
    "pg": "^8.13.1",
    "sql.js": "^1.13.0",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@uiw/codemirror-theme-vscode": "^4.25.12",
    "@uiw/react-codemirror": "^4.23.7",
    "@vitejs/plugin-react": "^4.3.4",
    "@xyflow/react": "^12.12.0",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "lucide-react": "^0.474.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "zustand": "^5.0.3"
  },
  "build": {
    "appId": "com.onedb.desktop",
    "productName": "OneDB",
    "directories": {
      "output": "release/${version}",
      "buildResources": "build"
    },
    "files": [
      "out/**"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "OneDB",
      "vendor": "OneDB"
    }
  }
}
